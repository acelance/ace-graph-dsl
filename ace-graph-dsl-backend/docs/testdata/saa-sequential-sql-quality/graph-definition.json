{
  "graphId": "saa-sequential-sql-quality",
  "displayName": "SAA Sequential：SQL 生成与评分",
  "version": "1.0.0",
  "description": "M1 样例：单节点 SAA_WORKFLOW(SEQUENTIAL)。子 Agent 引用设计器入库的通用 Agent（nodeId 须 agent: 前缀）：generic:agent:sql-gen / generic:agent:sql-rater。需引入 ace-graph-dsl-saa-agent。",
  "keyStrategies": {
    "user_query": "REPLACE",
    "sql": "REPLACE",
    "score": "REPLACE",
    "sql_score": "REPLACE",
    "ace.graph.dsl.saa.subSteps": "REPLACE",
    "ace.graph.dsl.saa.subStepsMeta": "REPLACE"
  },
  "nodes": [
    {
      "nodeId": "sql_quality",
      "category": "SAA_WORKFLOW",
      "config": { "label": "SQL 生成与评分" },
      "x": 320,
      "y": 200,
      "saaSpec": {
        "pattern": "SEQUENTIAL",
        "inputKeys": "user_query",
        "outputKey": "sql_score",
        "streamResponseKind": "BIZ",
        "subAgents": [
          {
            "name": "sql_generator",
            "impl": "GENERIC_AGENT",
            "ref": "generic:agent:sql-gen",
            "instruction": "{user_query}",
            "outputKey": "sql"
          },
          {
            "name": "sql_rater",
            "impl": "GENERIC_AGENT",
            "ref": "generic:agent:sql-rater",
            "instruction": "SQL:\n{sql}\n请求:\n{user_query}",
            "outputKey": "score"
          }
        ]
      }
    }
  ],
  "edges": [
    { "from": "__START__", "to": "sql_quality", "type": "normal" },
    { "from": "sql_quality", "to": "__END__", "type": "normal" }
  ],
  "compile": {
    "interruptBefore": [],
    "saver": "memory"
  }
}
